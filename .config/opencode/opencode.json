    }
  },
  "autoupdate": "notify",
  "lsp": {
    "csharp": {
      "disabled": true
    },
    "roslyn": {
      "command": [
        "/Users/rodrigo.soares/.local/share/nvim/mason/bin/roslyn",
        "--logLevel=Information",
        "--extensionLogDirectory=/tmp/roslyn-logs",
        "--stdio"
      ],
      "extensions": [
        ".cs"
      ]
    }
  },
  "plugin": [
    "@jet-ai-platform/lumen-opencode-plugin@0.1.13"
