{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b": {
          "name": "qwen2.5-coder:14b",
          "tools": "true"
        },
        "llama3:latest": {
          "name": "llama3:latest"
        },
        "second_constantine/deepseek-coder-v2:16b": {
          "name": "second_constantine/deepseek-coder-v2:16b",
          "tools": true 
        }
      }
    }
  },
  "mcp": {
    "bigquery": {
      "type": "local",
      "command": [
        "/Users/rodrigo.soares/bin/toolbox",
        "--prebuilt",
        "bigquery",
        "--stdio"
      ],
      "enabled": false,
      "environment": {
        "BIGQUERY_PROJECT": "{file:~/.config/opencode/.secrets}"
      }
    },
    "financecore": {
      "type": "remote",
      "url": "http://localhost:5001/mcp",
      "enabled": false,
      "headers": {
        "X-Tenant": "ie"
      }
    },
    "calendar": {
      "type": "local",
      "command": [
        "/Users/rodrigo.soares/personal/projects/mcp-macos-calendar/.build/debug/MCPMacOSCalendar",
        "--transport",
        "stdio"
      ],
      "enabled": false
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false
    },
    "things3": {
      "type": "local",
      "command": [
        "/Users/rodrigo.soares/personal/projects/mcp-things3/.build/debug/MCPThings3"
      ],
      "enabled": false
    },
    "anki": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@ankimcp/anki-mcp-server",
        "--stdio"
      ],
      "environment": {
        "ANKI_CONNECT_URL": "http://localhost:8765"
      },
      "enabled": false
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow"
  },
  "model": "ollama/qwen2.5-coder:14b",
  "autoupdate": "notify",
  "lsp": {
    "csharp": {
      "disabled": true
    },
    "roslyn": {
      "command": [
        "/Users/rodrigo.soares/.local/share/nvim/mason/bin/roslyn",
        "--logLevel=Information",
        "--extensionLogDirectory=/tmp/roslyn-logs",
        "--stdio"
      ],
      "extensions": [
        ".cs"
      ]
    }
  },
  "plugin": []
}
